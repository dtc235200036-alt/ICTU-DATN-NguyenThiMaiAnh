# Mật khẩu root MySQL (sinh tự động bởi deploy/init.sh)
MYSQL_ROOT_PASSWORD=__GENERATE__
# Tài khoản DB dùng cho Web API
MYSQL_USER=thesis_api
# Mật khẩu DB dùng cho Web API (sinh tự động bởi deploy/init.sh)
MYSQL_PASSWORD=__GENERATE__
# Cổng host map vào MySQL container, dùng cho pytest chạy trên máy host
MYSQL_HOST_PORT=3307
# Khóa ký JWT (sinh tự động, tối thiểu 32 ký tự)
JWT_SECRET=__GENERATE__
# Thời hạn access token (phút)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Thời hạn refresh token (phút) — độ dài phiên làm việc
REFRESH_TOKEN_EXPIRE_MINUTES=480
# Số vòng băm bcrypt (>=12 ngoài môi trường test)
BCRYPT_ROUNDS=12
# Chạy seed dữ liệu mẫu khi container api khởi động
SEED_ON_START=true
# Mật khẩu mặc định cho tài khoản seed (CHỈ dùng dev/demo)
SEED_DEFAULT_PASSWORD=DoAn@2026
# Web API gọi dịch vụ AI nào (D-07): "http" = dịch vụ AI thật (service `ai`),
# "stub" = bộ giả lập Phase 2/3 (phương án dự phòng)
AI_CLIENT=http
# Khóa nội bộ Web API -> dịch vụ AI (header X-API-Key, sinh tự động, >= 32 ký tự)
AI_API_KEY=__GENERATE__
# Mật khẩu tài khoản DB thesis_ai của dịch vụ AI (sinh tự động; chỉ SELECT/INSERT/UPDATE/DELETE trên thesis_ai.*)
AI_DB_PASSWORD=__GENERATE__
# Mật khẩu tài khoản DB thesis_ai_migrate (sinh tự động; DDL trên thesis_ai.*, chỉ service ai-migrate dùng — WR-03)
AI_DB_MIGRATE_PASSWORD=__GENERATE__
# Mô hình embedding (chốt sau bake-off, tools/bakeoff/ket-qua.json): bkai | e5
AI_MODEL_PROFILE=bkai
# Trần bộ nhớ của container ai
AI_MEM_LIMIT=2g
# Trần bộ nhớ của container api (CR-01 Phase 3: chặn upload làm cạn RAM host)
API_MEM_LIMIT=1g
# Chế độ giả lập Dịch vụ AI — CHỈ có hiệu lực khi AI_CLIENT=stub (D-07
# fallback): "normal" hoặc "loi" — đặt 'loi' để mô phỏng dịch vụ AI không
# phản hồi (UC1.1 – E2)
AI_STUB_MODE=normal
# Tên server dùng trong Apache vhost và chứng chỉ TLS
SERVER_NAME=localhost
# Cổng HTTP host (chỉ dùng để redirect sang HTTPS)
HTTP_PORT=80
# Cổng HTTPS host
HTTPS_PORT=443
