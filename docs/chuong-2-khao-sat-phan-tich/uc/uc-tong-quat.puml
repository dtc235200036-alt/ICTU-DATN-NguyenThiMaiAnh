@startuml uc-tong-quat
left to right direction
skinparam packageStyle rectangle

actor "Sinh viên" as SV
actor "Giảng viên" as GV
actor "Bộ môn" as BM
actor "Người dùng" as ND
actor "Dịch vụ AI" as AI

SV --|> ND
GV --|> ND
BM --|> ND

rectangle "Hệ thống quản lý đồ án – Khoa CNTT" {
  usecase "UC1 – Quản lý đề tài" as UC1 #lightblue
  usecase "UC2 – Quản lý đề cương" as UC2 #lightblue
  usecase "UC3 – Quản lý tiến độ thực hiện" as UC3 #lightblue
  usecase "UC4 – Quản lý bảo vệ" as UC4 #lightblue
  usecase "UC5 – Quản lý kho dữ liệu đồ án" as UC5 #lightblue
  usecase "UC0 – Chức năng chung" as UC0
  usecase "UC0.6 – Kiểm tra trùng lặp tên đề tài" as UC0_6
  usecase "UC0.7 – Kiểm tra trùng lặp tài liệu" as UC0_7
}

ND --> UC1
ND --> UC2
ND --> UC3
ND --> UC4
ND --> UC5
ND --> UC0

UC1 ..> UC0_6 : <<include>>
UC2 ..> UC0_7 : <<include>>
UC4 ..> UC0_7 : <<include>>
UC0_6 --> AI
UC0_7 --> AI
@enduml
