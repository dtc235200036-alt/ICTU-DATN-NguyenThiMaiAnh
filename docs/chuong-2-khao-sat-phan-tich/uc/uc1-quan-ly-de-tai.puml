@startuml uc1-quan-ly-de-tai
left to right direction
skinparam packageStyle rectangle

actor "Giảng viên\nhướng dẫn" as GV
actor "Sinh viên" as SV
actor "Bộ môn" as BM

rectangle "UC1 – Quản lý đề tài" {
  usecase "UC1.1 – Tạo và giao đề tài" as UC1_1
  usecase "UC1.2 – Xem và lọc danh sách đề tài" as UC1_2
  usecase "Đính kèm tệp mô tả đề tài" as UC1_X
  usecase "UC0.6 – Kiểm tra trùng lặp tên đề tài" as UC0_6
}

GV --> UC1_1
GV --> UC1_2
SV --> UC1_2
BM --> UC1_2
UC1_1 ..> UC0_6 : <<include>>
UC1_X ..> UC1_1 : <<extend>>
@enduml
