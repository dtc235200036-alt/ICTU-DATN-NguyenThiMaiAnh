@startuml uc4-quan-ly-bao-ve
left to right direction
skinparam packageStyle rectangle

actor "Sinh viên" as SV
actor "Giảng viên" as GV
actor "Bộ môn" as BM

rectangle "UC4 – Quản lý bảo vệ" {
  usecase "UC4.1 – Nộp báo cáo cuối" as UC4_1
  usecase "UC4.2 – Lập hội đồng và xếp lịch" as UC4_2
  usecase "UC4.3 – Chấm điểm và nhận xét" as UC4_3
  usecase "UC4.4 – Chốt kết quả bảo vệ" as UC4_4
  usecase "UC4.5 – Xem lịch và kết quả bảo vệ" as UC4_5
  usecase "UC0.7 – Kiểm tra trùng lặp tài liệu" as UC0_7
}

SV --> UC4_1
BM --> UC4_2
GV --> UC4_3
BM --> UC4_4
SV --> UC4_5

UC4_1 ..> UC0_7 : <<include>>

note right of UC0_7
  UC0.7 thuộc nhóm UC0 – Chức năng chung,
  đặc tả đầy đủ ở 11-dac-ta-uc0-chuc-nang-chung.md.
end note
@enduml
