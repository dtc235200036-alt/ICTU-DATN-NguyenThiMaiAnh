@startuml erd-thesis-ai
' Schema riêng của Dịch vụ AI (thesis_ai). Không có khóa ngoại nào trỏ
' sang thesis_core (xem erd.puml): ma_nguon chỉ là số tham chiếu logic do
' Web API gửi kèm khi gọi /ingest, giữ đúng ranh giới sở hữu dữ liệu.
' Quy ước: dấu * trước tên cột = NOT NULL.
hide circle
skinparam linetype ortho
skinparam nodesep 60

entity "chunk" as chunk {
  *id : BIGINT <<PK>>
  --
  *loai_nguon : VARCHAR(20) <<CHECK>>
  *ma_nguon : BIGINT
  *thu_tu : INT
  *noi_dung : TEXT
  *bam_noi_dung : CHAR(64)
  ..UQ(loai_nguon, ma_nguon, thu_tu)..
  ..INDEX(loai_nguon, ma_nguon)..
}

entity "embedding" as embedding {
  *id : BIGINT <<PK>>
  --
  *chunk_id : BIGINT <<FK>>
  *ten_model : VARCHAR(100)
  *so_chieu : INT
  *vector : BLOB
  ..UQ(chunk_id, ten_model)..
}

entity "index_metadata" as index_metadata {
  *id : BIGINT <<PK>>
  --
  *ten_model : VARCHAR(100) <<UQ>>
  *so_vector : BIGINT
  *cap_nhat_luc : DATETIME
}

chunk ||--o{ embedding : "ON DELETE CASCADE"

note right of chunk
  loai_nguon IN (TOPIC, ARCHIVE, DOCUMENT).
  ma_nguon là tham chiếu logic theo loai_nguon:
  TOPIC: de_tai.id, ARCHIVE: do_an_kho.id,
  DOCUMENT: tai_lieu_do_an.id (thesis_core).
  Không phải khóa ngoại.
end note

note right of embedding
  vector: mảng float32 đóng gói nhị phân.
  ten_model gồm tên mô hình và mã commit
  trọng số (repo@12 ký tự đầu của commit).
end note

@enduml
