@startuml erd
hide circle
skinparam linetype ortho

' =====================================================================
' Tài khoản & phân quyền
' =====================================================================
entity "tai_khoan" as tai_khoan {
  *id : BIGINT <<PK>>
  --
  ma_dang_nhap : VARCHAR(50) <<UNIQUE>> <<NOT NULL>>
  email : VARCHAR(150) <<UNIQUE>> <<NOT NULL>>
  mat_khau_bam : VARCHAR(255) <<NOT NULL>>
  vai_tro : ENUM('SINH_VIEN','GIANG_VIEN','BO_MON') <<NOT NULL>>
  bi_khoa : BOOLEAN <<NOT NULL>> = FALSE
  phien_ban_token : BIGINT <<NOT NULL>> = 0
}

' =====================================================================
' Người dùng, đợt đồ án, định hướng và đề tài
' =====================================================================
entity "sinh_vien" as sinh_vien {
  *id : BIGINT <<PK>>
  --
  tai_khoan_id : BIGINT <<FK>> <<UNIQUE>>
  ma_so_sinh_vien : VARCHAR(20) <<UNIQUE>>
  ho_ten : VARCHAR(150)
  email : VARCHAR(150)
  lop : VARCHAR(50)
  khoa : VARCHAR(100)
}

entity "giang_vien" as giang_vien {
  *id : BIGINT <<PK>>
  --
  tai_khoan_id : BIGINT <<FK>> <<UNIQUE>>
  ma_giang_vien : VARCHAR(20) <<UNIQUE>>
  ho_ten : VARCHAR(150)
  email : VARCHAR(150)
  hoc_vi : VARCHAR(50)
}

entity "dot_do_an" as dot_do_an {
  *id : BIGINT <<PK>>
  --
  ten_dot : VARCHAR(100)
  khoa : VARCHAR(20)
  nam_hoc : VARCHAR(20)
  ngay_bat_dau : DATE
  ngay_ket_thuc : DATE
  trang_thai : VARCHAR(20)
}

entity "phan_cong_huong_dan" as phan_cong_huong_dan {
  *id : BIGINT <<PK>>
  --
  dot_do_an_id : BIGINT <<FK>> <<NOT NULL>>
  sinh_vien_id : BIGINT <<FK>> <<NOT NULL>>
  giang_vien_id : BIGINT <<FK>> <<NOT NULL>>
  thoi_diem : DATETIME <<NOT NULL>>
  ..UNIQUE uk_phan_cong_sv_dot (dot_do_an_id, sinh_vien_id)..
}

entity "dinh_huong" as dinh_huong {
  *id : BIGINT <<PK>>
  --
  ma : VARCHAR(10) <<UNIQUE>> <<NOT NULL>>
  ten : VARCHAR(255) <<NOT NULL>>
  mo_ta : TEXT
  hoat_dong : BOOLEAN <<NOT NULL>> = TRUE
  tep_ten_goc : VARCHAR(255)
  tep_ten_luu_tru : VARCHAR(255) <<UNIQUE>>
  tep_kich_thuoc : BIGINT
  tep_cap_nhat_luc : DATETIME
}

entity "de_tai" as de_tai {
  *id : BIGINT <<PK>>
  --
  dot_do_an_id : BIGINT <<FK>> <<NOT NULL>>
  giang_vien_id : BIGINT <<FK>>
  sinh_vien_id : BIGINT <<FK>>
  sinh_vien_id_dang_hoat_dong : BIGINT <<derived>> <<UNIQUE>>
  ..cột sinh STORED: sinh_vien_id khi trang_thai đang hoạt động..
  ten_de_tai : VARCHAR(255)
  mo_ta : TEXT
  linh_vuc : VARCHAR(100)
  dinh_huong_id : BIGINT <<FK>>
  trang_thai : VARCHAR(20)
  loai_nguoi_de_xuat : VARCHAR(10)
  ly_do_tu_choi : TEXT
}

entity "ket_qua_kiem_tra_trung_lap" as ket_qua_kiem_tra_trung_lap {
  *id : BIGINT <<PK>>
  --
  de_tai_id : BIGINT <<FK>>
  tai_lieu_do_an_id : BIGINT <<FK>> <<UNIQUE>>
  loai_kiem_tra : VARCHAR(20)
  trang_thai : VARCHAR(20)
  ty_le_tong : DECIMAL(5,2)
  ty_le_nguon_cao_nhat : DECIMAL(5,2)
  so_doan : INT
  so_doan_loai_tru : INT
  ty_le_loai_tru : DECIMAL(5,2)
  nguong_ap_dung : DECIMAL(5,2)
  nguong_tong_ap_dung : DECIMAL(5,2)
  doi_tuong_duoc_kiem_tra : VARCHAR(255)
  thoi_diem : DATETIME
}

entity "chi_tiet_trung_lap" as chi_tiet_trung_lap {
  *id : BIGINT <<PK>>
  --
  ket_qua_id : BIGINT <<FK>>
  doi_tuong_trung : VARCHAR(255)
  ty_le : DECIMAL(5,2)
  doan_nguon : TEXT
  doan_trung : TEXT
  vi_tri : VARCHAR(50)
  loai_nguon : VARCHAR(20)
  nguon_id : BIGINT
  ty_le_nguon : DECIMAL(5,2)
}

' =====================================================================
' Đề cương, tài liệu, tiến độ (kế hoạch 01-05)
' =====================================================================
entity "moc_tien_do" as moc_tien_do {
  *id : BIGINT <<PK>>
  --
  dot_do_an_id : BIGINT <<FK>> <<NOT NULL>>
  ten_moc : VARCHAR(100)
  thu_tu : INT
  han_nop : DATE
}

entity "de_cuong" as de_cuong {
  *id : BIGINT <<PK>>
  --
  de_tai_id : BIGINT <<FK>> <<UNIQUE>> <<NOT NULL>>
  trang_thai : VARCHAR(20)
  ..CHECK trang_thai: 6 trạng thái đề cương..
  ngay_nop_dau_tien : DATETIME
  nop_bo_mon_luc : DATETIME
  ket_qua_bo_mon : VARCHAR(20)
}

entity "tai_lieu_do_an" as tai_lieu_do_an {
  *id : BIGINT <<PK>>
  --
  de_tai_id : BIGINT <<FK>> <<NOT NULL>>
  de_cuong_id : BIGINT <<FK>>
  loai : VARCHAR(20)
  so_phien_ban : INT
  ten_goc : VARCHAR(255)
  ten_luu_tru : VARCHAR(255) <<UNIQUE>>
  kich_thuoc : BIGINT
  dinh_dang : VARCHAR(10)
  thoi_diem_nop : DATETIME
  noi_dung_trich_xuat : LONGTEXT
  trich_xuat_loi : BOOLEAN <<NOT NULL>> = FALSE
  da_index_luc : DATETIME
  ghi_chu : TEXT
  ..CHECK loai: 6 loại tài liệu..
  ..UNIQUE(de_tai_id, loai, so_phien_ban)..
}

entity "luot_duyet_bo_mon" as luot_duyet_bo_mon {
  *id : BIGINT <<PK>>
  --
  de_cuong_id : BIGINT <<FK>> <<NOT NULL>>
  tai_lieu_do_an_id : BIGINT <<FK>> <<NOT NULL>>
  tai_khoan_id : BIGINT <<FK>> <<NOT NULL>>
  ket_qua : VARCHAR(20) <<NOT NULL>>
  ..CHECK ket_qua IN ('DA_DUYET','TRA_LAI')..
  nhan_xet : TEXT
  thoi_diem : DATETIME <<NOT NULL>>
  tai_lieu_ky_so_id : BIGINT <<FK>>
}

entity "luot_duyet_de_cuong" as luot_duyet_de_cuong {
  *id : BIGINT <<PK>>
  --
  de_cuong_id : BIGINT <<FK>> <<NOT NULL>>
  tai_lieu_do_an_id : BIGINT <<FK>> <<UNIQUE>> <<NOT NULL>>
  giang_vien_id : BIGINT <<FK>> <<NOT NULL>>
  ket_qua : VARCHAR(20)
  nhan_xet : TEXT
  thoi_diem : DATETIME
}

entity "bao_cao_tien_do" as bao_cao_tien_do {
  *id : BIGINT <<PK>>
  --
  de_tai_id : BIGINT <<FK>> <<NOT NULL>>
  moc_tien_do_id : BIGINT <<FK>> <<NOT NULL>>
  noi_dung : TEXT
  thoi_diem_nop : DATETIME
  nhan_xet : TEXT
  danh_gia : VARCHAR(20)
  tai_lieu_do_an_id : BIGINT <<FK>>
  ..UNIQUE(de_tai_id, moc_tien_do_id)..
}

' =====================================================================
' Hội đồng & bảo vệ
' =====================================================================
entity "hoi_dong" as hoi_dong {
  *id : BIGINT <<PK>>
  --
  ten_hoi_dong : VARCHAR(150)
  ngay_bao_ve : DATE
  gio_bao_ve : TIME
  phong : VARCHAR(50)
}

entity "thanh_vien_hoi_dong" as thanh_vien_hoi_dong {
  *id : BIGINT <<PK>>
  --
  hoi_dong_id : BIGINT <<FK>> <<NOT NULL>>
  giang_vien_id : BIGINT <<FK>> <<NOT NULL>>
  vai_tro : VARCHAR(20)
  ..UNIQUE(hoi_dong_id, giang_vien_id)..
}

entity "lich_bao_ve" as lich_bao_ve {
  *id : BIGINT <<PK>>
  --
  hoi_dong_id : BIGINT <<FK>> <<NOT NULL>>
  de_tai_id : BIGINT <<FK>> <<NOT NULL>>
  sinh_vien_id : BIGINT <<FK>> <<UNIQUE>> <<NOT NULL>>
  thu_tu : INT
  diem_trung_binh : DECIMAL(4,2)
  da_chot : BOOLEAN = FALSE
}

entity "diem_bao_ve" as diem_bao_ve {
  *id : BIGINT <<PK>>
  --
  lich_bao_ve_id : BIGINT <<FK>> <<NOT NULL>>
  giang_vien_id : BIGINT <<FK>> <<NOT NULL>>
  diem : DECIMAL(4,2)
  nhan_xet : TEXT
  ..UNIQUE(lich_bao_ve_id, giang_vien_id)..
}

' =====================================================================
' Kho đồ án, thông báo, cấu hình
' =====================================================================
entity "do_an_kho" as do_an_kho {
  *id : BIGINT <<PK>>
  --
  de_tai_id : BIGINT <<FK>>
  sinh_vien_id : BIGINT <<FK>>
  giang_vien_id : BIGINT <<FK>>
  khoa : VARCHAR(20)
  ten_de_tai : VARCHAR(255)
  tu_khoa : VARCHAR(255)
  diem : DECIMAL(4,2)
  nguon : VARCHAR(20)
  trang_thai_index : VARCHAR(20)
  ma_so_sinh_vien : VARCHAR(20)
  ho_ten_sinh_vien : VARCHAR(150)
}

entity "thong_bao" as thong_bao {
  *id : BIGINT <<PK>>
  --
  tai_khoan_id : BIGINT <<FK>> <<NOT NULL>>
  loai : VARCHAR(30)
  noi_dung : TEXT
  lien_ket : VARCHAR(255)
  da_doc : BOOLEAN = FALSE
  thoi_diem : DATETIME
}

entity "cau_hinh_nguong" as cau_hinh_nguong {
  *id : BIGINT <<PK>>
  --
  loai : VARCHAR(30) <<UNIQUE>>
  gia_tri : DECIMAL(5,2)
  tai_khoan_id : BIGINT <<FK>>
  thoi_diem_cap_nhat : DATETIME
}

' =====================================================================
' Quan hệ — tài khoản & phân quyền
' =====================================================================
tai_khoan ||--o| sinh_vien : "1 tài khoản là 0..1 SV"
tai_khoan ||--o| giang_vien : "1 tài khoản là 0..1 GV"
tai_khoan ||--o{ thong_bao : "1 tài khoản nhận nhiều thông báo"
tai_khoan ||--o{ cau_hinh_nguong : "1 tài khoản cập nhật nhiều cấu hình"

' =====================================================================
' Quan hệ — đề tài và kiểm tra trùng lặp
' =====================================================================
dot_do_an ||--o{ de_tai : "1 đợt có nhiều đề tài"
giang_vien |o--o{ de_tai : "GVHD tạo và giao"
sinh_vien |o--o{ de_tai : "SV được giao (tối đa 1 đang hoạt động)"
dinh_huong |o--o{ de_tai : "fk_de_tai_dinh_huong"
de_tai |o--o{ ket_qua_kiem_tra_trung_lap : "kết quả kiểm tra tên"
ket_qua_kiem_tra_trung_lap ||--o{ chi_tiet_trung_lap : "1 kết quả có nhiều chi tiết"

' =====================================================================
' Quan hệ — phân công GVHD theo đợt (UC0.8, Alembic 0015)
' =====================================================================
dot_do_an ||--o{ phan_cong_huong_dan : "fk_phan_cong_dot_do_an"
sinh_vien ||--o{ phan_cong_huong_dan : "fk_phan_cong_sinh_vien (tối đa 1 mỗi đợt)"
giang_vien ||--o{ phan_cong_huong_dan : "fk_phan_cong_giang_vien (lớp hướng dẫn)"

' =====================================================================
' Quan hệ — đề cương, tài liệu, tiến độ
' =====================================================================
dot_do_an ||--o{ moc_tien_do : "1 đợt định nghĩa nhiều mốc"
de_tai ||--o| de_cuong : "1 đề tài có 0..1 đề cương"
de_cuong |o--o{ tai_lieu_do_an : "1 đề cương có nhiều phiên bản"
de_tai ||--o{ tai_lieu_do_an : "1 đề tài có nhiều tài liệu"
de_cuong ||--o{ luot_duyet_de_cuong : "1 đề cương có nhiều lượt duyệt"
tai_lieu_do_an ||--o| luot_duyet_de_cuong : "1 phiên bản có 0..1 lượt duyệt"
giang_vien ||--o{ luot_duyet_de_cuong : "1 GV duyệt nhiều lượt"
de_cuong ||--o{ luot_duyet_bo_mon : "1 đề cương có nhiều lượt Bộ môn duyệt"
tai_lieu_do_an ||--o{ luot_duyet_bo_mon : "phiên bản được nộp lên"
tai_lieu_do_an |o--o| luot_duyet_bo_mon : "tai_lieu_ky_so_id (bản PDF đã ký)"
tai_khoan ||--o{ luot_duyet_bo_mon : "tài khoản Bộ môn thực hiện"
de_tai ||--o{ bao_cao_tien_do : "1 đề tài nộp nhiều báo cáo"
moc_tien_do ||--o{ bao_cao_tien_do : "1 mốc áp dụng nhiều báo cáo"
tai_lieu_do_an |o--o| bao_cao_tien_do : "tệp đính kèm tùy chọn (PROG-01)"
tai_lieu_do_an |o--o| ket_qua_kiem_tra_trung_lap : "1 phiên bản có 0..1 kết quả kiểm tra (loại = TÀI_LIỆU)"

' =====================================================================
' Quan hệ — hội đồng & bảo vệ
' =====================================================================
hoi_dong ||--o{ thanh_vien_hoi_dong : "1 hội đồng có nhiều thành viên"
giang_vien ||--o{ thanh_vien_hoi_dong : "1 GV là thành viên nhiều hội đồng"
hoi_dong ||--o{ lich_bao_ve : "1 hội đồng xếp nhiều lịch"
de_tai ||--o| lich_bao_ve : "1 đề tài có 0..1 lịch bảo vệ"
sinh_vien ||--o| lich_bao_ve : "1 SV có 0..1 lịch bảo vệ"
lich_bao_ve ||--o{ diem_bao_ve : "1 lịch nhận nhiều điểm thành viên"
giang_vien ||--o{ diem_bao_ve : "1 GV chấm nhiều điểm"

' =====================================================================
' Quan hệ — kho đồ án
' =====================================================================
de_tai |o--o| do_an_kho : "gốc (null nếu import khóa cũ)"
sinh_vien |o--o{ do_an_kho : "của SV"
giang_vien |o--o{ do_an_kho : "GVHD"

@enduml
