@startuml component
skinparam componentStyle rectangle
skinparam nodesep 25
skinparam ranksep 40

component "Client React\n(SPA build tĩnh)" as Client
component "Apache HTTP Server\n(TLS, reverse proxy)" as Apache

package "Web API (FastAPI)" as WA {
  component "Xác thực và\nphân quyền" as WA_Auth
  component "Quản trị: tài khoản, đợt,\nđịnh hướng, phân công, ngưỡng" as WA_QuanTri
  component "Đề tài" as WA_DeTai
  component "Đề cương\n(duyệt hai cấp)" as WA_DeCuong
  component "Tiến độ" as WA_TienDo
  component "Bảo vệ" as WA_BaoVe
  component "Kho đồ án" as WA_Kho
  component "Thông báo,\ntổng quan" as WA_ThongBao
  component "Lưu trữ tệp,\ntrích xuất văn bản" as WA_Storage
  component "AI client\n(kiểm tra trùng lặp, ingest)" as WA_AIClient
}

package "Dịch vụ AI kiểm tra trùng lặp (FastAPI)" {
  component "API nội bộ: /ingest, /check-title,\n/check-document, /reindex (yêu cầu X-API-Key);\n/health (kiểm tra sống)" as AI_API
  component "Chuẩn hóa NFC,\nlọc mẫu chung, tách câu" as AI_NLP
  component "Mô hình embedding\n(vietnamese-bi-encoder)" as AI_Embed
  component "Chỉ mục FAISS\nvà chỉ mục vân tay" as AI_Index
}

database "MySQL\nthesis_core" as DB_core
database "MySQL\nthesis_ai" as DB_ai
folder "Kho tệp\ntải lên" as FileStore

Client --> Apache : HTTPS
Apache --> WA_Auth : "/api/* (REST, JWT)"
WA_Auth --> WA_QuanTri
WA_Auth --> WA_DeTai
WA_Auth --> WA_DeCuong
WA_Auth --> WA_TienDo
WA_Auth --> WA_BaoVe
WA_Auth --> WA_Kho
WA_Auth --> WA_ThongBao

WA_DeTai --> WA_AIClient
WA_DeCuong --> WA_AIClient
WA_BaoVe --> WA_AIClient
WA_Kho --> WA_AIClient
WA_DeTai --> WA_Storage
WA_DeCuong --> WA_Storage
WA_TienDo --> WA_Storage
WA_BaoVe --> WA_Storage
WA_Storage --> FileStore

WA_AIClient ..> AI_API : "REST nội bộ\n(X-API-Key)"
AI_API --> AI_NLP
AI_NLP --> AI_Embed
AI_Embed --> AI_Index
AI_Index --> DB_ai : "chunk, embedding"

WA --> DB_core : "SQLAlchemy ORM"

note right of Apache
  Chỉ có route tới build tĩnh và /api/*.
  Không có route công khai tới Dịch vụ AI.
end note

@enduml
