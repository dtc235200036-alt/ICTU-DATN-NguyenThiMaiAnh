@startuml deployment
' Sơ đồ triển khai mức thiết kế: các nút, vùng mạng và giao thức.
' Cách hiện thực bằng Docker Compose (container, volume, IP) trình bày ở chương 4.
skinparam nodesep 40
skinparam ranksep 50

node "Máy người dùng" as UserMachine {
  component "Trình duyệt Web" as Browser
}

node "Máy chủ ứng dụng" as Server {
  node "Vùng công khai" as Public {
    node "Máy chủ Web Apache\n(TLS, cổng 443; 80 chuyển sang 443)" as Apache {
      artifact "Client Web\n(bản build tĩnh React)" as ClientBuild
    }
  }
  node "Vùng nội bộ (không công bố cổng ra ngoài)" as Internal {
    node "Web API\n(FastAPI, Uvicorn)" as WebAPI
    node "Dịch vụ AI\n(FastAPI, Uvicorn)" as AIService {
      artifact "Mô hình embedding,\nchỉ mục FAISS, MinHash" as AIModel
    }
    node "MySQL 8" as MySQL {
      database "thesis_core" as SchemaCore
      database "thesis_ai" as SchemaAI
    }
    storage "Kho tệp tải lên\n(ngoài DocumentRoot)" as Upload
  }
}

Browser --> Apache : "HTTPS"
Apache --> WebAPI : "reverse proxy /api/\n(HTTP nội bộ)"
WebAPI --> AIService : "REST nội bộ\n(X-API-Key)"
WebAPI --> SchemaCore : "SQL, tài khoản riêng"
AIService --> SchemaAI : "SQL, tài khoản riêng"
WebAPI --> Upload : "đọc/ghi tệp"

@enduml
