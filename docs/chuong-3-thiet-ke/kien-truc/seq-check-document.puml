@startuml seq-check-document
autonumber
hide footbox
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 140

actor "Sinh viên" as User
participant "Client React" as Client
participant "Web API" as WebAPI
participant "Tác vụ nền\n(Web API)" as BgTask
participant "Dịch vụ AI" as AIService
database "thesis_core" as DBCore

User -> Client : Nộp tệp DOCX/PDF (UC2.1, UC4.1)
Client -> WebAPI : POST /api/outlines/{id}/submit (multipart, JWT)
WebAPI -> WebAPI : Kiểm tra magic bytes, dung lượng; lưu tệp; trích xuất văn bản (NFC)
WebAPI -> DBCore : INSERT tai_lieu_do_an, ket_qua (DANG_KIEM_TRA); COMMIT
WebAPI --> Client : 202 {trạng thái kiểm tra: DANG_KIEM_TRA}
WebAPI ->> BgTask : Kích hoạt tác vụ nền
BgTask -> AIService : POST /check-document (X-API-Key) {ref_id, text, nguong_doan, loai_tru}

alt Thành công trong thời gian chờ
  AIService -> AIService : Lọc mẫu chung, tách câu; so khớp MinHash và FAISS
  AIService --> BgTask : 200 {ty_le_tong, do_an_trung, chi_tiet, phạm vi}
  BgTask -> DBCore : UPDATE ket_qua (HOAN_TAT); INSERT chi_tiet_trung_lap
  BgTask -> AIService : POST /ingest {id, DOCUMENT, text}
else Hết thời gian chờ hoặc lỗi
  AIService --> BgTask : Không phản hồi / lỗi
  BgTask -> DBCore : UPDATE ket_qua (LOI)
end

loop Khi còn DANG_KIEM_TRA
  Client -> WebAPI : GET /api/documents/{id}/check
  WebAPI --> Client : {trang_thai, ty_le_tong, ...}
end
Client --> User : Hiển thị tỷ lệ và đoạn trùng (MH-08, MH-14)

@enduml
