@startuml seq-check-title
autonumber
hide footbox
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 140

actor "GVHD" as User
participant "Client React" as Client
participant "Web API" as WebAPI
participant "Dịch vụ AI" as AIService
database "thesis_core" as DBCore

User -> Client : Nhập đề tài, chọn SV, bấm "Giao đề tài" (MH-06)
Client -> WebAPI : POST /api/topics {gui: true} (JWT, qua Apache)
WebAPI -> WebAPI : Kiểm tra vai trò, đợt mở, SV thuộc lớp hướng dẫn; NFC
WebAPI -> DBCore : Đọc NGUONG_TEN_DE_TAI
WebAPI -> AIService : POST /check-title (X-API-Key) {text, top_k, nguong}

alt Phản hồi trong thời gian chờ
  AIService -> AIService : Mã hóa tên, tìm FAISS trên phân vùng tên đề tài
  AIService --> WebAPI : 200 {matches: [{ref_id, loai, ty_le}]}
else Hết thời gian chờ hoặc lỗi
  AIService --> WebAPI : Không phản hồi / lỗi
  WebAPI -> WebAPI : Kết quả LOI, không chặn việc giao
end

WebAPI -> DBCore : INSERT de_tai (DA_PHAN_CONG), ket_qua, chi_tiet, thong_bao; COMMIT
WebAPI --> Client : 201 {đề tài, kết quả kiểm tra tên}
Client --> User : Hiển thị đề tài tương tự kèm tỷ lệ
WebAPI ->> AIService : Tác vụ nền: POST /ingest {id, TOPIC, text}

@enduml
