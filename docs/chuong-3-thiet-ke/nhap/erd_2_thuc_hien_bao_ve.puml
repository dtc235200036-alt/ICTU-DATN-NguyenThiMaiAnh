@startuml
title ERD 2 – Quá trình thực hiện và bảo vệ
hide circle
skinparam linetype ortho
skinparam defaultFontName Arial

entity nguoi_dung {
  * id : INT <<PK>>
  --
  ..
}

entity giang_vien {
  * id : INT <<PK>>
  --
  * nguoi_dung_id : INT <<FK>> <<UQ>>
  * bo_mon_id : INT <<FK>>
  ..
}

entity khoa_hoc {
  * id : INT <<PK>>
  --
  ..
}

entity dot_do_an {
  * id : INT <<PK>>
  --
  * khoa_hoc_id : INT <<FK>>
  ..
}

entity dang_ky_de_tai {
  * id : INT <<PK>>
  --
  * de_tai_id : INT <<FK>>
  * sinh_vien_id : INT <<FK>>
  * giang_vien_id : INT <<FK>>
   nguoi_duyet_id : INT <<FK>>
  ..
}

entity tai_lieu {
  * id : INT <<PK>>
  --
   nguoi_nop_id : INT <<FK>>
   do_an_id : INT <<FK>>
  * loai : ENUM
  * ten_file : VARCHAR(255)
  * duong_dan : VARCHAR(500)
  * kich_thuoc : INT
  * ngay_tai_len : DATETIME
}

entity de_cuong {
  * id : INT <<PK>>
  --
  * dang_ky_id : INT <<FK>>
  * tai_lieu_id : INT <<FK>>
  * phien_ban : SMALLINT
  * trang_thai : ENUM
   nhan_xet : TEXT
  * ngay_nop : DATETIME
}

entity bao_cao_tien_do {
  * id : INT <<PK>>
  --
  * dang_ky_id : INT <<FK>>
   tai_lieu_id : INT <<FK>>
  * tuan_so : TINYINT
  * da_lam : TEXT
  * ket_qua : TEXT
   kho_khan : TEXT
  * ke_hoach : TEXT
   nhan_xet : TEXT
   danh_gia : ENUM
  * ngay_nop : DATETIME
}

entity bao_cao_cuoi {
  * id : INT <<PK>>
  --
  * dang_ky_id : INT <<FK>> <<UQ>>
  * tai_lieu_id : INT <<FK>>
   ma_nguon_id : INT <<FK>>
   nhan_xet_gvhd : TEXT
  * du_dieu_kien_bao_ve : ENUM
  * ngay_nop : DATETIME
}

entity hoi_dong {
  * id : INT <<PK>>
  --
  * dot_id : INT <<FK>>
  * ten : VARCHAR(100)
   phong : VARCHAR(50)
  * ngay_bao_ve : DATE
}

entity thanh_vien_hoi_dong {
  * hoi_dong_id : INT <<PK>> <<FK>>
  * giang_vien_id : INT <<PK>> <<FK>>
  --
  * vai_tro : ENUM
}

entity lich_bao_ve {
  * id : INT <<PK>>
  --
  * hoi_dong_id : INT <<FK>>
  * dang_ky_id : INT <<FK>> <<UQ>>
  * gio_bat_dau : TIME
  * thu_tu : TINYINT
}

entity diem_bao_ve {
  * id : INT <<PK>>
  --
  * lich_bao_ve_id : INT <<FK>>
  * giang_vien_id : INT <<FK>>
  * diem : DECIMAL(4,2)
   nhan_xet : TEXT
}

entity do_an_luu_tru {
  * id : INT <<PK>>
  --
   dang_ky_id : INT <<FK>> <<UQ>>
   khoa_hoc_id : INT <<FK>>
  * ten_de_tai : VARCHAR(255)
   ho_ten_sv : VARCHAR(100)
   ho_ten_gvhd : VARCHAR(100)
   nam_bao_ve : SMALLINT
  * nguon : ENUM
}

nguoi_dung ||--o| giang_vien
khoa_hoc ||--o{ dot_do_an
giang_vien ||--o{ dang_ky_de_tai
nguoi_dung |o--o{ dang_ky_de_tai
nguoi_dung |o--o{ tai_lieu
do_an_luu_tru |o--o{ tai_lieu
dang_ky_de_tai ||--o{ de_cuong
tai_lieu ||--o{ de_cuong
dang_ky_de_tai ||--o{ bao_cao_tien_do
tai_lieu |o--o{ bao_cao_tien_do
dang_ky_de_tai ||--o| bao_cao_cuoi
tai_lieu ||--o{ bao_cao_cuoi
tai_lieu |o--o{ bao_cao_cuoi
dot_do_an ||--o{ hoi_dong
hoi_dong ||--o{ thanh_vien_hoi_dong
giang_vien ||--o{ thanh_vien_hoi_dong
hoi_dong ||--o{ lich_bao_ve
dang_ky_de_tai ||--o| lich_bao_ve
lich_bao_ve ||--o{ diem_bao_ve
giang_vien ||--o{ diem_bao_ve
dang_ky_de_tai |o--o| do_an_luu_tru
khoa_hoc |o--o{ do_an_luu_tru

@enduml
