@startuml lop-thuc-the

' =====================================================================
' Enum — vai trò, trạng thái, phân loại (dùng chung cho các lớp bên dưới)
' =====================================================================
enum VaiTro {
  SINH_VIEN
  GIANG_VIEN
  BO_MON
}

enum TrangThaiDot {
  DANG_MO
  DA_DONG
}

enum TrangThaiDeTai {
  NHAP
  DA_PHAN_CONG
  .. giá trị cũ, không còn phát sinh ..
  CHO_DUYET
  DA_DUYET
  TU_CHOI
}

enum LoaiNguoiDeXuat {
  GIANG_VIEN
  SINH_VIEN
}

enum TrangThaiDeCuong {
  CHUA_NOP
  CHO_DUYET
  YEU_CAU_SUA
  GVHD_DA_DUYET
  CHO_BO_MON_DUYET
  DA_DUYET
}

enum LoaiTaiLieu {
  DE_TAI
  DE_CUONG
  DE_CUONG_KY_SO
  BAO_CAO_TIEN_DO
  BAO_CAO_CUOI
  KHO
}

enum KetQuaDuyet {
  DA_DUYET
  YEU_CAU_SUA
}

enum KetQuaDuyetBoMon {
  DA_DUYET
  TRA_LAI
}

enum DanhGiaTienDo {
  DAT
  CAN_CAI_THIEN
  CHUA_DAT
}

enum VaiTroHoiDong {
  CHU_TICH
  THU_KY
  UY_VIEN
}

enum LoaiKiemTra {
  TEN_DE_TAI
  TAI_LIEU
}

enum TrangThaiKiemTra {
  DANG_KIEM_TRA
  HOAN_TAT
  LOI
}

enum LoaiNguon {
  HE_THONG
  IMPORT
}

enum TrangThaiIndex {
  CHUA_INDEX
  DA_INDEX
}

enum LoaiThongBao {
  PHAN_CONG_GVHD
  DE_TAI_PHAN_CONG
  DE_CUONG_MOI
  DE_CUONG_DUYET
  DE_CUONG_YEU_CAU_SUA
  DE_CUONG_NOP_BO_MON
  DE_CUONG_BO_MON_DUYET
  DE_CUONG_BO_MON_TRA_LAI
  TIEN_DO_NHAN_XET
  HOI_DONG_PHAN_CONG
  LICH_BAO_VE
  KET_QUA_BAO_VE
  .. giá trị cũ, không còn phát sinh ..
  DE_TAI_CHO_DUYET
  DE_TAI_DUYET
  DE_TAI_TU_CHOI
}

enum LoaiCauHinhNguong {
  NGUONG_TEN_DE_TAI
  NGUONG_TAI_LIEU
  NGUONG_TONG_TAI_LIEU
  NGUONG_DOAN_TRUNG
}

enum KhongGianNguon {
  TOPIC
  ARCHIVE
  DOCUMENT
}

' =====================================================================
' Tài khoản & phân quyền
' =====================================================================
class TaiKhoan <<Entity>> {
  +maDangNhap : String
  +email : String
  +matKhauBam : String
  +vaiTro : VaiTro
  +biKhoa : Boolean
  +phienBanToken : Long
}

' =====================================================================
' Người dùng, đợt đồ án, định hướng và đề tài
' =====================================================================
class SinhVien <<Entity>> {
  +maSoSinhVien : String
  +hoTen : String
  +email : String
  +lop : String
  +khoa : String
}

class GiangVien <<Entity>> {
  +maGiangVien : String
  +hoTen : String
  +email : String
  +hocVi : String
}

class DotDoAn <<Entity>> {
  +tenDot : String
  +khoa : String
  +namHoc : String
  +ngayBatDau : Date
  +ngayKetThuc : Date
  +trangThai : TrangThaiDot
}

class PhanCongHuongDan <<Entity>> {
  +thoiDiem : DateTime
}

class DinhHuong <<Entity>> {
  +ma : String
  +ten : String
  +moTa : String
  +hoatDong : Boolean
  +tepTenGoc : String
  +tepTenLuuTru : String
  +tepKichThuoc : Long
  +tepCapNhatLuc : DateTime
}

class DeTai <<Entity>> {
  +tenDeTai : String
  +moTa : String
  +linhVuc : String
  +trangThai : TrangThaiDeTai
  +loaiNguoiDeXuat : LoaiNguoiDeXuat
  +lyDoTuChoi : String
}

class KetQuaKiemTraTrungLap <<Entity>> {
  +loaiKiemTra : LoaiKiemTra
  +trangThai : TrangThaiKiemTra
  +tyLeTong : Double
  +tyLeNguonCaoNhat : Double
  +soDoan : Integer
  +soDoanLoaiTru : Integer
  +tyLeLoaiTru : Double
  +nguongApDung : Double
  +nguongTongApDung : Double
  +doiTuongDuocKiemTra : String
  +thoiDiem : DateTime
}

class ChiTietTrungLap <<Entity>> {
  +doiTuongTrung : String
  +tyLe : Double
  +doanNguon : String
  +doanTrung : String
  +viTri : String
  +loaiNguon : KhongGianNguon
  +nguonId : Long
  +tyLeNguon : Double
}

' =====================================================================
' Đề cương & tài liệu (kế hoạch 01-05)
' =====================================================================
class MocTienDo <<Entity>> {
  +tenMoc : String
  +thuTu : Integer
  +hanNop : Date
}

class DeCuong <<Entity>> {
  +trangThai : TrangThaiDeCuong
  +ngayNopDauTien : DateTime
  +nopBoMonLuc : DateTime
  +ketQuaBoMon : KetQuaDuyetBoMon
}

class TaiLieuDoAn <<Entity>> {
  +loai : LoaiTaiLieu
  +soPhienBan : Integer
  +tenGoc : String
  +tenLuuTru : String
  +kichThuoc : Long
  +dinhDang : String
  +thoiDiemNop : DateTime
  +noiDungTrichXuat : String
  +trichXuatLoi : Boolean
  +daIndexLuc : DateTime
  +ghiChu : String
}

class LuotDuyetDeCuong <<Entity>> {
  +ketQua : KetQuaDuyet
  +nhanXet : String
  +thoiDiem : DateTime
}

class LuotDuyetBoMon <<Entity>> {
  +ketQua : KetQuaDuyetBoMon
  +nhanXet : String
  +thoiDiem : DateTime
}

class BaoCaoTienDo <<Entity>> {
  +noiDung : String
  +thoiDiemNop : DateTime
  +nhanXet : String
  +danhGia : DanhGiaTienDo
}

' =====================================================================
' Hội đồng & bảo vệ
' =====================================================================
class HoiDong <<Entity>> {
  +tenHoiDong : String
  +ngayBaoVe : Date
  +gioBaoVe : Time
  +phong : String
}

class ThanhVienHoiDong <<Entity>> {
  +vaiTro : VaiTroHoiDong
}

class LichBaoVe <<Entity>> {
  +thuTu : Integer
  +diemTrungBinh : Decimal
  +daChot : Boolean
}

class DiemBaoVe <<Entity>> {
  +diem : Decimal
  +nhanXet : String
}

' =====================================================================
' Kho đồ án, thông báo, cấu hình
' =====================================================================
class DoAnKho <<Entity>> {
  +khoa : String
  +tenDeTai : String
  +tuKhoa : String
  +diem : Decimal
  +nguon : LoaiNguon
  +trangThaiIndex : TrangThaiIndex
  +maSoSinhVien : String
  +hoTenSinhVien : String
}

class ThongBao <<Entity>> {
  +loai : LoaiThongBao
  +noiDung : String
  +lienKet : String
  +daDoc : Boolean
  +thoiDiem : DateTime
}

class CauHinhNguong <<Entity>> {
  +loai : LoaiCauHinhNguong
  +giaTri : Decimal
  +thoiDiemCapNhat : DateTime
}

' =====================================================================
' Associations — Tài khoản & phân quyền
' =====================================================================
TaiKhoan "1" -- "0..1" SinhVien : "là tài khoản của"
TaiKhoan "1" -- "0..1" GiangVien : "là tài khoản của"
TaiKhoan "1" -- "*" ThongBao : "nhận"
TaiKhoan "1" -- "*" CauHinhNguong : "cập nhật"
TaiKhoan "0..1" -- "*" KetQuaKiemTraTrungLap : "tải tệp lên kiểm tra"

' =====================================================================
' Associations — đề tài và kiểm tra trùng lặp
' =====================================================================
DotDoAn "1" -- "*" DeTai : "thuộc đợt"
GiangVien "0..1" -- "*" DeTai : "tạo và giao (GVHD)"
SinhVien "0..1" -- "*" DeTai : "được giao\n(tối đa 1 đề tài đang hoạt động)"
DinhHuong "0..1" -- "*" DeTai : "thuộc định hướng"
DeTai "0..1" -- "*" KetQuaKiemTraTrungLap : "có kết quả kiểm tra tên"
KetQuaKiemTraTrungLap "1" -- "*" ChiTietTrungLap : "gồm chi tiết"

' =====================================================================
' Associations — phân công GVHD theo đợt (UC0.8, Alembic 0015)
' Mỗi (DotDoAn, SinhVien) có tối đa một PhanCongHuongDan.
' =====================================================================
DotDoAn "1" -- "*" PhanCongHuongDan : "phân công trong đợt"
SinhVien "1" -- "*" PhanCongHuongDan : "được phân công\n(tối đa 1 mỗi đợt)"
GiangVien "1" -- "*" PhanCongHuongDan : "hướng dẫn (lớp)"

' =====================================================================
' Associations — đề cương, tài liệu, tiến độ
' =====================================================================
DotDoAn "1" -- "*" MocTienDo : "định nghĩa mốc"
DeTai "1" -- "0..1" DeCuong : "có đề cương"
DeCuong "1" -- "*" TaiLieuDoAn : "gồm các phiên bản (DE_CUONG, DE_CUONG_KY_SO)"
DeCuong "1" -- "*" LuotDuyetDeCuong : "có các lượt duyệt"
GiangVien "1" -- "*" LuotDuyetDeCuong : "duyệt"
DeCuong "1" -- "*" LuotDuyetBoMon : "có các lượt phê duyệt của Bộ môn"
TaiKhoan "1" -- "*" LuotDuyetBoMon : "Bộ môn phê duyệt"
TaiLieuDoAn "1" -- "*" LuotDuyetBoMon : "phiên bản được nộp lên"
TaiLieuDoAn "0..1" -- "0..1" LuotDuyetBoMon : "bản PDF đã ký"
DeTai "1" -- "*" BaoCaoTienDo : "nộp báo cáo theo mốc"
MocTienDo "1" -- "*" BaoCaoTienDo : "áp dụng cho"
BaoCaoTienDo "0..1" -- "0..1" TaiLieuDoAn : "đính kèm"
DeTai "1" -- "*" TaiLieuDoAn : "có tài liệu (tệp đề tài, báo cáo cuối...)"
TaiLieuDoAn "0..1" -- "0..1" KetQuaKiemTraTrungLap : "được kiểm tra trùng lặp (loại = TAI_LIEU)"

' =====================================================================
' Associations — hội đồng & bảo vệ
' =====================================================================
HoiDong "1" -- "*" ThanhVienHoiDong : "gồm thành viên"
ThanhVienHoiDong "*" -- "1" GiangVien : "là"
HoiDong "1" -- "*" LichBaoVe : "xếp lịch"
LichBaoVe "0..1" -- "1" SinhVien : "của"
LichBaoVe "0..1" -- "1" DeTai : "bảo vệ đề tài"
LichBaoVe "1" -- "*" DiemBaoVe : "nhận điểm từ thành viên"
GiangVien "1" -- "*" DiemBaoVe : "chấm"

' =====================================================================
' Associations — kho đồ án
' =====================================================================
DoAnKho "0..1" -- "0..1" DeTai : "gốc (null nếu import khóa cũ)"
DoAnKho "*" -- "0..1" SinhVien : "của SV"
DoAnKho "*" -- "0..1" GiangVien : "GVHD"

' =====================================================================
' Phụ thuộc lớp -> enum (giữ mọi enum trong cùng một thành phần liên
' thông với sơ đồ; nếu để enum là node cô lập, engine layout Smetana -
' bản đi kèm PlantUML dùng khi không có Graphviz `dot` - có lỗi
' ArrayIndexOutOfBoundsException không xác định khi dựng sơ đồ có nhiều
' thành phần liên thông rời rạc kích thước 1. Xem SUMMARY 01-05.)
' =====================================================================
TaiKhoan ..> VaiTro
DotDoAn ..> TrangThaiDot
DeTai ..> TrangThaiDeTai
DeTai ..> LoaiNguoiDeXuat
DeCuong ..> TrangThaiDeCuong
TaiLieuDoAn ..> LoaiTaiLieu
LuotDuyetDeCuong ..> KetQuaDuyet
LuotDuyetBoMon ..> KetQuaDuyetBoMon
BaoCaoTienDo ..> DanhGiaTienDo
ThanhVienHoiDong ..> VaiTroHoiDong
KetQuaKiemTraTrungLap ..> LoaiKiemTra
KetQuaKiemTraTrungLap ..> TrangThaiKiemTra
ChiTietTrungLap ..> KhongGianNguon
DoAnKho ..> LoaiNguon
DoAnKho ..> TrangThaiIndex
ThongBao ..> LoaiThongBao
CauHinhNguong ..> LoaiCauHinhNguong

@enduml
